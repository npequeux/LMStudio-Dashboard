##############################################################################
#
#   Gradle start up script for POSIX generated by Gradle.
#
#   Target OS: Unix-like systems (Linux, macOS)
#
##############################################################################

# Attempt to set APP_HOME
app_path=$0

while
    APP_HOME=${app_path%"${app_path##*/}"}
    [ -h "$app_path" ]
do
    ls=$( ls -ld -- "$app_path" )
    link=${ls#* -> }
    case $link in
      /*)   app_path=$link ;;
      *)    app_path=$APP_HOME$link ;;
    esac
done

APP_HOME=$( cd "${APP_HOME:-./}" && pwd -P ) || exit

CLASSPATH=$APP_HOME/gradle/wrapper/gradle-wrapper.jar

# Determine the Java command to use.
if [ -n "$JAVA_HOME" ] ; then
    JAVACMD="$JAVA_HOME/bin/java"
else
    JAVACMD=java
fi

# Build JVM args from environment variables (exported by CI or user).
JVM_ARGS=""
[ -n "${JAVA_OPTS:-}" ] && JVM_ARGS="$JVM_ARGS $JAVA_OPTS"
[ -n "${GRADLE_OPTS:-}" ] && JVM_ARGS="$JVM_ARGS $GRADLE_OPTS"

# Default memory settings if not overridden.
if [ -z "$JVM_ARGS" ]; then
    JVM_ARGS="-Xmx64m -Xms64m"
fi

exec "$JAVACMD" $JVM_ARGS -classpath "$CLASSPATH" org.gradle.wrapper.GradleWrapperMain "$@"