<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DashboardLMStudio.ViewModels"
             x:Class="DashboardLMStudio.MainPage"
             Title="LM STUDIO MONITOR"
             BackgroundColor="{StaticResource LcarsBackground}">

    <ContentPage.BindingContext>
        <vm:MainViewModel />
    </ContentPage.BindingContext>

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">

            <!-- Header padd -->
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                <Border Grid.Column="0"
                        BackgroundColor="{StaticResource LcarsOrange}"
                        StrokeShape="RoundRectangle 16"
                        Padding="18,12">
                    <Label Text="LM STUDIO MONITOR"
                           TextColor="{StaticResource LcarsInk}"
                           FontSize="20"
                           FontAttributes="Bold" />
                </Border>
                <ActivityIndicator Grid.Column="1"
                                   IsRunning="{Binding IsConnecting}"
                                   IsVisible="{Binding IsConnecting}"
                                   Color="{StaticResource LcarsLightBlue}"
                                   VerticalOptions="Center" />
                <Border Grid.Column="2"
                        BackgroundColor="{Binding ConnectionStatusFill}"
                        StrokeShape="RoundRectangle 16"
                        Padding="16,12"
                        VerticalOptions="Center">
                    <Label Text="{Binding ConnectionStatusText}"
                           TextColor="{StaticResource LcarsInk}"
                           FontSize="12"
                           FontAttributes="Bold" />
                </Border>
            </Grid>

            <!-- Connection padd -->
            <Border BackgroundColor="{StaticResource LcarsPanel}"
                    Stroke="{StaticResource LcarsBlue}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 18"
                    Padding="16">
                <VerticalStackLayout Spacing="10">
                    <Entry Text="{Binding ServerUrl}"
                           Placeholder="BRIDGE URL"
                           TextColor="{StaticResource LcarsText}"
                           PlaceholderColor="{StaticResource LcarsTextDim}"
                           BackgroundColor="{StaticResource LcarsBackground}" />
                    <Entry Text="{Binding ApiKey}"
                           Placeholder="API KEY (OPTIONAL)"
                           IsPassword="True"
                           TextColor="{StaticResource LcarsText}"
                           PlaceholderColor="{StaticResource LcarsTextDim}"
                           BackgroundColor="{StaticResource LcarsBackground}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Grid.Column="0"
                                Text="CONNECT"
                                Command="{Binding ConnectCommand}"
                                IsEnabled="{Binding CanConnect}"
                                BackgroundColor="{StaticResource LcarsGreen}"
                                TextColor="{StaticResource LcarsInk}"
                                CornerRadius="12" />
                        <Button Grid.Column="1"
                                Text="DISCONNECT"
                                Command="{Binding DisconnectCommand}"
                                IsEnabled="{Binding CanDisconnect}"
                                BackgroundColor="{StaticResource LcarsRed}"
                                TextColor="White"
                                CornerRadius="12" />
                    </Grid>
                    <Button Text="{Binding MonitoringLabel}"
                            Command="{Binding ToggleMonitoringCommand}"
                            BackgroundColor="{StaticResource LcarsLightBlue}"
                            TextColor="{StaticResource LcarsInk}"
                            CornerRadius="12" />
                    <Label Text="{Binding StatusText}"
                           TextColor="{StaticResource LcarsTextDim}"
                           FontSize="11"
                           LineBreakMode="TailTruncation" />
                </VerticalStackLayout>
            </Border>

            <!-- Metric padds -->
            <Grid ColumnDefinitions="*,*"
                  RowDefinitions="Auto,Auto,Auto"
                  ColumnSpacing="12"
                  RowSpacing="12">

                <Border Grid.Row="0" Grid.Column="0"
                        BackgroundColor="{StaticResource LcarsOrange}"
                        StrokeShape="RoundRectangle 16"
                        Padding="14,10">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="CPU USAGE" TextColor="{StaticResource LcarsInk}" FontSize="11" FontAttributes="Bold" />
                        <Label Text="{Binding CpuText}" TextColor="{StaticResource LcarsInk}" FontSize="26" FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="0" Grid.Column="1"
                        BackgroundColor="{StaticResource LcarsLightBlue}"
                        StrokeShape="RoundRectangle 16"
                        Padding="14,10">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="MEMORY" TextColor="{StaticResource LcarsInk}" FontSize="11" FontAttributes="Bold" />
                        <Label Text="{Binding MemoryText}" TextColor="{StaticResource LcarsInk}" FontSize="26" FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="1" Grid.Column="0"
                        BackgroundColor="{StaticResource LcarsPurple}"
                        StrokeShape="RoundRectangle 16"
                        Padding="14,10">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="TOKENS/SEC" TextColor="{StaticResource LcarsInk}" FontSize="11" FontAttributes="Bold" />
                        <Label Text="{Binding TokenText}" TextColor="{StaticResource LcarsInk}" FontSize="26" FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="1" Grid.Column="1"
                        BackgroundColor="{StaticResource LcarsLavender}"
                        StrokeShape="RoundRectangle 16"
                        Padding="14,10">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="GPU / VRAM" TextColor="{StaticResource LcarsInk}" FontSize="11" FontAttributes="Bold" />
                        <Label Text="{Binding GpuText}" TextColor="{StaticResource LcarsInk}" FontSize="20" FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="2" Grid.Column="0"
                        BackgroundColor="{StaticResource LcarsLightOrange}"
                        StrokeShape="RoundRectangle 16"
                        Padding="14,10">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="PROMPT / COMPLETION" TextColor="{StaticResource LcarsInk}" FontSize="11" FontAttributes="Bold" />
                        <Label Text="{Binding PromptCompletionText}" TextColor="{StaticResource LcarsInk}" FontSize="20" FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="2" Grid.Column="1"
                        BackgroundColor="{StaticResource LcarsRed}"
                        StrokeShape="RoundRectangle 16"
                        Padding="14,10">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="ERRORS" TextColor="White" FontSize="11" FontAttributes="Bold" />
                        <Label Text="{Binding ErrorCountText}" TextColor="White" FontSize="26" FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Border>

            </Grid>

            <!-- Error log padd -->
            <Border BackgroundColor="{StaticResource LcarsPanel}"
                    Stroke="{StaticResource LcarsRed}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 18"
                    Padding="14">
                <VerticalStackLayout Spacing="8">
                    <Label Text="ERROR LOG"
                           TextColor="{StaticResource LcarsLightBlue}"
                           FontSize="14"
                           FontAttributes="Bold" />
                    <CollectionView ItemsSource="{Binding Errors}" HeightRequest="220">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <VerticalStackLayout Padding="6" Spacing="2">
                                    <HorizontalStackLayout Spacing="8">
                                        <Label Text="{Binding Timestamp}" TextColor="{StaticResource LcarsTextDim}" FontSize="11" />
                                        <Label Text="{Binding Level}" TextColor="{Binding LevelColor}" FontSize="11" FontAttributes="Bold" />
                                        <Label Text="{Binding SourceLabel}" TextColor="{StaticResource LcarsTextDim}" FontSize="11" />
                                    </HorizontalStackLayout>
                                    <Label Text="{Binding Message}" TextColor="{StaticResource LcarsText}" FontSize="12" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
